@model HotelMS.Models.Room
@{
    ViewData["Title"] = "Edit Room";
}

<div class="page-header">
    <div>
        <h2 class="section-title"><i class="fas fa-edit"></i> Edit Room @Model.RoomNumber</h2>
        <p class="section-sub">Update room details</p>
    </div>
    <a href="/Room/ViewRooms" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="form-card">
    <form asp-action="UpdateRoom" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="RoomID" type="hidden" />
        <div class="form-grid form-grid-2">
            <div class="form-group">
                <label asp-for="RoomNumber" class="form-label">Room Number</label>
                <input asp-for="RoomNumber" class="form-input" />
                <span asp-validation-for="RoomNumber" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomType" class="form-label">Room Type</label>
                <select asp-for="RoomType" class="form-input form-select">
                    <option value="Single">Single</option>
                    <option value="Double">Double</option>
                    <option value="Suite">Suite</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="form-label">Price Per Night ($)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" class="form-input" />
                <span asp-validation-for="Price" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-input form-select">
                    <option value="Available">Available</option>
                    <option value="Booked">Booked</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
            <a href="/Room/ViewRooms" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
        </div>
    </form>
</div>
