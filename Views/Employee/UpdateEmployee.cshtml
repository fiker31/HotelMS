@model HotelMS.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-header">
    <div>
        <h2 class="section-title"><i class="fas fa-user-edit"></i> Edit Employee</h2>
        <p class="section-sub">Update @Model.Name's information</p>
    </div>
    <a href="/Employee/ListEmployees" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="form-card">
    <form asp-action="UpdateEmployee" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="EmployeeID" type="hidden" />
        <div class="form-grid form-grid-2">
            <div class="form-group form-full">
                <label asp-for="Name" class="form-label">Full Name</label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Position" class="form-label">Position</label>
                <select asp-for="Position" class="form-input form-select">
                    <option value="Manager">Manager</option>
                    <option value="Receptionist">Receptionist</option>
                    <option value="Staff">Staff</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Salary" class="form-label">Salary ($)</label>
                <input asp-for="Salary" type="number" step="0.01" class="form-input" />
                <span asp-validation-for="Salary" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gender" class="form-label">Gender</label>
                <select asp-for="Gender" class="form-input form-select">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Age" class="form-label">Age</label>
                <input asp-for="Age" type="number" min="18" max="70" class="form-input" />
                <span asp-validation-for="Age" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <a href="/Employee/ListEmployees" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
        </div>
    </form>
</div>
