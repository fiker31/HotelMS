@model HotelMS.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hotel Luxe — Sign In</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-body">

<div class="login-particles">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
</div>

<div class="login-container">
    <div class="login-card @(ViewBag.Error != null ? "shake" : "")">

        <div class="login-logo">
            <div class="logo-icon"><i class="fas fa-hotel"></i></div>
            <h1 class="hotel-name">Hotel Luxe</h1>
            <p class="hotel-tagline">Management System</p>
        </div>

        <div class="login-divider">
            <span>Welcome Back</span>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="login-error">
                <i class="fas fa-exclamation-circle"></i>
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post" id="login-form">
            @Html.AntiForgeryToken()

            <div class="form-group float-label">
                <div class="input-icon-wrap">
                    <i class="fas fa-user input-icon"></i>
                    <input asp-for="Username" type="text" class="form-input" placeholder=" " autocomplete="username" />
                    <label asp-for="Username" class="float-lbl">Username</label>
                </div>
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-group float-label">
                <div class="input-icon-wrap">
                    <i class="fas fa-lock input-icon"></i>
                    <input asp-for="Password" type="password" class="form-input" placeholder=" " autocomplete="current-password" id="login-password" />
                    <label asp-for="Password" class="float-lbl">Password</label>
                    <button type="button" class="toggle-password" onclick="togglePassword()" tabindex="-1">
                        <i class="fas fa-eye" id="pw-icon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button type="submit" class="login-btn" id="login-submit">
                <span class="btn-text"><i class="fas fa-sign-in-alt"></i> Sign In</span>
                <span class="btn-spinner" style="display:none"><i class="fas fa-circle-notch fa-spin"></i> Signing in...</span>
            </button>
        </form>

        <div class="login-hint">
            <i class="fas fa-info-circle"></i>
            Default admin: <strong>admin</strong> / <strong>admin123</strong>
        </div>
    </div>

    <div class="login-footer">
        &copy; @DateTime.Now.Year Hotel Luxe Management System
    </div>
</div>

<script>
function togglePassword() {
    const input = document.getElementById('login-password');
    const icon = document.getElementById('pw-icon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fas fa-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'fas fa-eye';
    }
}

document.getElementById('login-form').addEventListener('submit', function() {
    const btn = document.getElementById('login-submit');
    document.querySelector('.btn-text').style.display = 'none';
    document.querySelector('.btn-spinner').style.display = 'inline';
    btn.disabled = true;
});
</script>
</body>
</html>
