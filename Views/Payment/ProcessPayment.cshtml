@model HotelMS.Models.Payment
@{
    ViewData["Title"] = "Process Payment";
    var res = ViewBag.Reservation as HotelMS.Models.Reservation;
}

<div class="page-header">
    <div>
        <h2 class="section-title"><i class="fas fa-credit-card"></i> Process Payment</h2>
        <p class="section-sub">Reservation #@res?.ReservationID — @res?.Guest?.FullName</p>
    </div>
    <a href="/Reservation/GetReservationById/@res?.ReservationID" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="reservation-layout">
    <!-- Bill Summary -->
    <div class="reservation-preview">
        <div class="preview-header">
            <i class="fas fa-file-invoice-dollar"></i>
            <h3>Bill Summary</h3>
        </div>
        <div class="preview-body">
            @if (res != null)
            {
                <div class="preview-row"><span>Guest</span><strong>@res.Guest?.FullName</strong></div>
                <div class="preview-row"><span>Room</span><strong>@res.Room?.RoomNumber (@res.Room?.RoomType)</strong></div>
                <div class="preview-row"><span>Check-In</span><strong>@res.CheckInDate.ToString("MMM dd, yyyy")</strong></div>
                <div class="preview-row"><span>Check-Out</span><strong>@res.CheckOutDate.ToString("MMM dd, yyyy")</strong></div>
                <div class="preview-row"><span>Nights</span><strong>@res.TotalNights</strong></div>
                <div class="preview-divider"></div>
                <div class="preview-row"><span>Rate/Night</span><strong>$@res.Room?.Price.ToString("N2")</strong></div>
                <div class="preview-row preview-total"><span>Subtotal</span><strong>$@ViewBag.TotalDue?.ToString("N2")</strong></div>
                <div class="preview-row"><span>Paid</span><strong class="text-success">$@ViewBag.TotalPaid?.ToString("N2")</strong></div>
                <div class="preview-divider"></div>
                <div class="preview-row preview-grand"><span>Balance Due</span><strong class="gold-text">$@ViewBag.BalanceDue?.ToString("N2")</strong></div>
            }
        </div>
    </div>

    <!-- Payment Form -->
    <div class="form-card">
        <h3 class="form-section-title"><i class="fas fa-money-bill-wave"></i> Record Payment</h3>
        <form asp-action="ProcessPayment" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="ReservationID" type="hidden" />
            <div class="form-group">
                <label asp-for="Amount" class="form-label">Amount ($)</label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-input" />
                <span asp-validation-for="Amount" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-input form-select">
                    <option value="Cash">Cash</option>
                    <option value="CreditCard">Credit Card</option>
                    <option value="DebitCard">Debit Card</option>
                    <option value="Online">Online Transfer</option>
                </select>
            </div>
            <div class="form-actions">
                <a href="/Reservation/GetReservationById/@res?.ReservationID" class="btn btn-outline">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Record Payment</button>
            </div>
        </form>
    </div>
</div>
