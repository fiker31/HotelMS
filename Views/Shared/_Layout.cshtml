<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Hotel Luxe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@{
    var role = Context.Session.GetString("UserRole") ?? "";
    var username = Context.Session.GetString("Username") ?? "";
    var currentPath = Context.Request.Path.ToString().ToLower();
}

<!-- Sidebar -->
<nav id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="fas fa-hotel"></i>
            <span class="sidebar-brand">Hotel Luxe</span>
        </div>
        <div class="sidebar-tagline">Management System</div>
    </div>

    <ul class="sidebar-nav">
        <li class="nav-item">
            <a href="/Dashboard/Index" class="nav-link @(currentPath.Contains("/dashboard") ? "active" : "")">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
        </li>

        @if (role == "Admin" || role == "Manager" || role == "Receptionist")
        {
            <li class="nav-section">RESERVATIONS</li>
            <li class="nav-item">
                <a href="/Reservation/ListAllReservations" class="nav-link @(currentPath.Contains("/reservation") ? "active" : "")">
                    <i class="fas fa-calendar-check"></i>
                    <span>Reservations</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/Guest/ListAllGuests" class="nav-link @(currentPath.Contains("/guest") ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>Guests</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="/Payment/ListAllPayments" class="nav-link @(currentPath.Contains("/payment") ? "active" : "")">
                    <i class="fas fa-credit-card"></i>
                    <span>Payments</span>
                </a>
            </li>
        }

        @if (role != "")
        {
            <li class="nav-section">ROOMS</li>
            <li class="nav-item">
                <a href="/Room/ViewRooms" class="nav-link @(currentPath.Contains("/room") ? "active" : "")">
                    <i class="fas fa-door-open"></i>
                    <span>Rooms</span>
                </a>
            </li>
        }

        @if (role == "Admin" || role == "Manager")
        {
            <li class="nav-section">MANAGEMENT</li>
            <li class="nav-item">
                <a href="/Employee/ListEmployees" class="nav-link @(currentPath.Contains("/employee") ? "active" : "")">
                    <i class="fas fa-user-tie"></i>
                    <span>Employees</span>
                </a>
            </li>
        }

        @if (role == "Admin")
        {
            <li class="nav-item">
                <a href="/Account/ListAllAccounts" class="nav-link @(currentPath.Contains("/account/list") ? "active" : "")">
                    <i class="fas fa-shield-alt"></i>
                    <span>Accounts</span>
                </a>
            </li>
        }
    </ul>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="user-avatar"><i class="fas fa-user"></i></div>
            <div class="user-info">
                <div class="user-name">@username</div>
                <div class="user-role">@role</div>
            </div>
        </div>
        <a href="/Account/Logout" class="sidebar-logout" title="Logout">
            <i class="fas fa-sign-out-alt"></i>
        </a>
    </div>
</nav>

<!-- Main content -->
<div id="main-content">
    <partial name="_Navbar" />

    <div class="page-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" id="auto-alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" id="auto-alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        }

        @RenderBody()
    </div>
</div>

<div id="confirm-modal" class="modal-overlay" style="display:none">
    <div class="modal-box">
        <div class="modal-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <h3 class="modal-title">Confirm Delete</h3>
        <p class="modal-message">Are you sure you want to delete this record? This action cannot be undone.</p>
        <div class="modal-actions">
            <button id="modal-cancel" class="btn btn-outline">Cancel</button>
            <button id="modal-confirm" class="btn btn-danger">Delete</button>
        </div>
    </div>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
