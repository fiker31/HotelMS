@model HotelMS.Models.Guest
@{
    ViewData["Title"] = "Edit Guest";
}

<div class="page-header">
    <div>
        <h2 class="section-title"><i class="fas fa-user-edit"></i> Edit Guest</h2>
        <p class="section-sub">Update guest information</p>
    </div>
    <a href="/Guest/ListAllGuests" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="form-card">
    <form asp-action="UpdateGuest" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="GuestID" type="hidden" />
        <div class="form-grid form-grid-2">
            <div class="form-group">
                <label asp-for="FirstName" class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-input" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-input" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone" class="form-label">Phone Number</label>
                <input asp-for="Phone" class="form-input" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-input" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <a href="/Guest/ListAllGuests" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
        </div>
    </form>
</div>
