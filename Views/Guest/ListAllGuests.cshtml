@model IEnumerable<HotelMS.Models.Guest>
@{
    ViewData["Title"] = "Guests";
}

<div class="page-header">
    <div>
        <h2 class="section-title"><i class="fas fa-users"></i> Guests</h2>
        <p class="section-sub">@Model.Count() guests registered</p>
    </div>
    <a href="/Guest/AddGuest" class="btn btn-primary"><i class="fas fa-plus"></i> Add Guest</a>
</div>

<div class="card">
    <div class="card-toolbar">
        <form method="get" action="/Guest/ListAllGuests" class="search-form">
            <div class="search-wrap">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name, email or phone..." class="search-input" />
                <button type="submit" class="btn btn-primary btn-sm">Search</button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search?.ToString()))
                {
                    <a href="/Guest/ListAllGuests" class="btn btn-outline btn-sm">Clear</a>
                }
            </div>
        </form>
    </div>
    <div class="card-body">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Reservations</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>@g.GuestID</td>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar-sm guest-av">@g.FirstName[0]@g.LastName[0]</div>
                                @g.FullName
                            </div>
                        </td>
                        <td><i class="fas fa-phone text-muted"></i> @g.Phone</td>
                        <td><i class="fas fa-envelope text-muted"></i> @g.Email</td>
                        <td>
                            <span class="badge badge-info">@g.Reservations.Count</span>
                        </td>
                        <td>
                            <div class="action-btns">
                                <a href="/Guest/UpdateGuest/@g.GuestID" class="btn-icon btn-icon-edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteGuest" asp-controller="Guest" method="post" class="delete-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@g.GuestID" />
                                    <button type="submit" class="btn-icon btn-icon-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users-slash"></i>
                <p>No guests found.</p>
                <a href="/Guest/AddGuest" class="btn btn-primary btn-sm">Add First Guest</a>
            </div>
        }
    </div>
</div>
